# Copia a .env.prod en el servidor de producción. NUNCA subir el archivo real al repositorio.
#
# Este archivo lo leen los CONTENEDORES (`env_file:` de compose.prod.yaml). Aparte hace falta un
# `.env` junto a compose.prod.yaml, que es el único que Compose usa para interpolar `${...}`:
#
#   TASKFLOW_IMAGE=ghcr.io/ernestoas/taskflow:<versión>   # imagen a desplegar
#   TASKFLOW_HTTP_PORT=8082                               # puerto de loopback de web
#
# Poner esas dos variables aquí no tiene efecto: la interpolación no lee `env_file:`. Ver
# docs/operacion.md.

# PostgreSQL
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=cambiar-por-una-contraseña-segura
DATABASE_URL=postgres://taskflow:cambiar-por-una-contraseña-segura@db:5432/taskflow

# Django
DJANGO_SECRET_KEY=generar-con-python-c-secrets.token_urlsafe(50)
DJANGO_ALLOWED_HOSTS=sistemas.reduaz.mx,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://sistemas.reduaz.mx
# TaskFlow vive en https://sistemas.reduaz.mx/taskflow/ (sin dominio propio). Si algún día tiene
# dominio propio, dejar esta variable vacía y cambiar las dos de arriba.
DJANGO_FORCE_SCRIPT_NAME=/taskflow

DJANGO_MIGRATE=1
DJANGO_SECURE_COOKIES=True
# HSTS en 0: sistemas.reduaz.mx conserva el 8080 para enlaces viejos de actividades-uaz, y HSTS
# aplica al dominio con todos sus puertos (ver Despliegue-HTTPS-Nginx.md de actividades-uaz).
DJANGO_SECURE_HSTS_SECONDS=0

# Gunicorn: 2 workers, la VM de 8 GB la comparten actividades-uaz, mi-campus y TaskFlow.
GUNICORN_CMD_ARGS=--bind=0.0.0.0:8000 --workers=2 --timeout=60 --access-logfile=-
