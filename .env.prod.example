# Copia a /opt/taskflow/.env.prod en el servidor de producción (permisos 600, dueño root).
# NUNCA subir el archivo real al repositorio. Llenado paso a paso: docs/operacion.md.
#
# Este archivo lo leen los CONTENEDORES (`env_file:` de compose.prod.yaml). Aparte hace falta un
# `.env` junto a compose.prod.yaml, que es el único que Compose usa para interpolar `${...}`:
#
#   TASKFLOW_IMAGE=ghcr.io/ernestoas/taskflow:<versión>   # imagen a desplegar
#   TASKFLOW_HTTP_PORT=8082                               # puerto de loopback de web
#
# Poner esas dos variables aquí no tiene efecto: la interpolación no lee `env_file:`.

# PostgreSQL. La contraseña se fija la PRIMERA vez que arranca la base (al crear el volumen):
# cambiarla aquí después no cambia la de la base y `web` deja de conectarse. Debe ser la misma en
# POSTGRES_PASSWORD y en DATABASE_URL (generar con: python3 -c "import secrets; print(secrets.token_urlsafe(24))").
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=cambiar-por-una-contraseña-segura
DATABASE_URL=postgres://taskflow:cambiar-por-una-contraseña-segura@db:5432/taskflow

# Django (clave: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=generar-con-python-c-secrets.token_urlsafe(50)
DJANGO_ALLOWED_HOSTS=taskflow.rourendev.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://taskflow.rourendev.com
# Vacío: TaskFlow vive en la raíz de su dominio. Solo si se publicara bajo una ruta de otro dominio
# (p. ej. /taskflow), poner aquí esa ruta (docs/operacion.md, «Publicar bajo una ruta»).
DJANGO_FORCE_SCRIPT_NAME=

# URL pública (sin diagonal final): va en los enlaces de los correos de invitación.
TASKFLOW_URL=https://taskflow.rourendev.com
# Cualquiera puede crear su cuenta en /app/#/registro. False: solo entra quien recibe invitación.
TASKFLOW_REGISTRO_ABIERTO=True
# Intentos de entrar/registrarse/pedir código por IP (protección contra fuerza bruta).
TASKFLOW_LIMITE_ACCESO=20/min

# Correo (invitaciones, código para confirmar la cuenta y para recuperar la contraseña) por Resend
# (SMTP). Sin DJANGO_EMAIL_HOST, los correos solo se imprimen en el registro del contenedor
# (docker compose logs web) y NO llegan a nadie: con el registro abierto, nadie podría terminar de
# crear su cuenta. Puerto 587 (STARTTLS): Hetzner bloquea la salida por 25 y 465.
# La contraseña es una API key de Resend con permiso «Sending access» (empieza con re_).
DJANGO_EMAIL_HOST=smtp.resend.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=resend
DJANGO_EMAIL_HOST_PASSWORD=re_cambiar-por-la-api-key
DJANGO_DEFAULT_FROM_EMAIL=TaskFlow <no-responder@rourendev.com>

DJANGO_MIGRATE=1
DJANGO_SECURE_COOKIES=True
# HSTS: empezar con 300 al tener HTTPS; si todo funciona, subir a 31536000 (un año). Solo aplica a
# este subdominio (no incluye subdominios).
DJANGO_SECURE_HSTS_SECONDS=300

# Gunicorn: 3 workers (2 vCPU que compartirán otras apps del servidor; regla común 2 × núcleos + 1).
GUNICORN_CMD_ARGS=--bind=0.0.0.0:8000 --workers=3 --timeout=60 --access-logfile=-
