# Copia a .env para desarrollo local (docker compose lo carga si existe).
DJANGO_DEBUG_TOOLBAR=True
DJANGO_LOG_LEVEL=INFO

# Correo de desarrollo (p. ej. Mailtrap). Sin estas variables, los correos salen en la consola
# (docker compose logs -f web).
# DJANGO_EMAIL_HOST=sandbox.smtp.mailtrap.io
# DJANGO_EMAIL_PORT=2525
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=

# Puertos publicados en el host (docker compose)
TASKFLOW_WEB_PORT=8030
TASKFLOW_DB_PORT=5452
